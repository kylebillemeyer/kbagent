{
  "name": "kbagent-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code",
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:KB_AGENT_CLAUDE_CODE_OAUTH_TOKEN}",
    "GITHUB_TOKEN": "${localEnv:KB_AGENT_GITHUB_TOKEN}",
    "KB_AGENT_PLANE_API_KEY": "${localEnv:KB_AGENT_PLANE_API_KEY}",
    "NOTION_API_KEY": "${localEnv:NOTION_API_KEY}",
    "PLANE_API_KEY": "${localEnv:PLANE_API_KEY}",
    "PLANE_WORKSPACE_SLUG": "${localEnv:PLANE_WORKSPACE_SLUG}"
  }
}
