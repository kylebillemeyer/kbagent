# Environment for the kbagent UI (Vercel project root directory: ui/).
# Copy to ui/.env.local for local development. None of this is read by the daemon —
# the daemon has its own layered secrets under ~/.kbagent (see ../.env.example).

# Postgres connection for Drizzle. The Supabase *pooler* URI (Project Settings →
# Database → Connection pooling), including the database password. This is a Postgres
# credential, not an API key: a service-role key is a PostgREST JWT and cannot open a
# Postgres connection. All data access goes through this; nothing uses PostgREST.
#
# src/lib/db.ts appends `?pgbouncer=true&connection_limit=1` if they are absent, and
# translates them into driver options — see the comments there.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth (magic link). The anon key is a publishable key and is meant to reach
# the browser; it is used for auth only, never for data.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# The entire authorization model: the one address allowed to sign in. Every route
# rejects any other authenticated identity with 403. This is not a policy knob — a
# second user is a redesign, not another entry here.
ALLOWED_EMAIL=you@example.com
