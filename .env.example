# Account-scoped credentials for kbagent.
# Copy to ~/.kbagent/.env and fill in values.
#
# Secrets load in layers, later layers winning:
#   1. ~/.kbagent/.env              this file — credentials tied to your account
#   2. ~/.kbagent/<project>.env     credentials tied to one project's integrations
#   3. exported environment vars    always win over both files
#
# <project> is `name` from that project's kbagent.toml (default: basename of repo_path),
# so each project can point at its own ticket database or GitHub repos. Put a credential
# here only if it is genuinely the same everywhere; otherwise it belongs in the project
# file. Nothing secret goes in kbagent.toml — that lives in the repo.
#
# Run `kbagent -f /path/to/file daemon` to replace layer 1; the project layer still applies.
#
# Project-specific *config* (repo path, worktrees dir, project name, etc.) belongs in
# kbagent.toml at the root of each target project repo.

# Tied to your Anthropic account — the same for every project.
KB_AGENT_CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token

# The ticket store. Required — the daemon connects to Postgres directly over this URL.
# For Supabase, take it from Project Settings → Database → Connection string (the
# session or transaction pooler URI, with the database password filled in). This is a
# database credential, not the service-role API key: the service-role key is a
# PostgREST JWT and cannot authenticate a Postgres connection.
#
# Keep it here only while one database covers every project; move it to
# ~/.kbagent/<project>.env otherwise.
KB_AGENT_DATABASE_URL=postgresql://user:password@host:6543/postgres

# Tied to a set of GitHub repos.
KB_AGENT_GITHUB_TOKEN=ghp_your-github-token

# MCP server credentials for agent containers.
# Define these with the KB_AGENT_ prefix on the host. remoteEnv in
# .devcontainer/devcontainer.json maps each one to the unprefixed name the MCP server
# natively expects inside the container (e.g. KB_AGENT_NOTION_API_KEY -> NOTION_TOKEN),
# so project .mcp.json files need no env mapping.
KB_AGENT_NOTION_API_KEY=your-notion-api-key
