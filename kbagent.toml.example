# Identifies this project. Also selects its secrets file: ~/.kbagent/<name>.env,
# and is the `workspaces.slug` the daemon looks up in the ticket database.
# Defaults to the basename of repo_path when omitted.
name            = "your-project"
repo_path       = "/absolute/path/to/your-project"
worktrees_dir   = "/absolute/path/to/your-project-worktrees"
ticket_provider = "native"
validate_cmd    = "npm test"
max_turns       = 50
sleep_no_work   = 15
sleep_error     = 300
log_file        = "/Users/you/Library/Logs/kbagent.log"

# The ticket store itself is a Postgres connection string, which is a secret:
# it lives in ~/.kbagent/.env (or ~/.kbagent/<name>.env) as KB_AGENT_DATABASE_URL,
# never here — kbagent.toml is committed to the repo.
