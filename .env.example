# Account-scoped credentials for kbagent.
# Copy to ~/.kbagent/.env and fill in values.
#
# Secrets load in layers, later layers winning:
#   1. ~/.kbagent/.env              this file — credentials tied to your account
#   2. ~/.kbagent/<project>.env     credentials tied to one project's integrations
#   3. exported environment vars    always win over both files
#
# <project> is `name` from that project's kbagent.toml (default: basename of repo_path),
# so each project can point at its own Plane workspace, GitHub repos, or Supabase project.
# Put a credential here only if it is genuinely the same everywhere; otherwise it belongs
# in the project file. Nothing secret goes in kbagent.toml — that lives in the repo.
#
# Run `kbagent -f /path/to/file daemon` to replace layer 1; the project layer still applies.
#
# Project-specific *config* (repo path, worktrees dir, Plane project/states, etc.)
# belongs in kbagent.toml at the root of each target project repo.

# Tied to your Anthropic account — the same for every project.
KB_AGENT_CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token

# Tied to a Plane workspace and a set of GitHub repos. Keep them here only while one
# credential covers every project; move them to ~/.kbagent/<project>.env otherwise.
KB_AGENT_PLANE_API_KEY=your-plane-api-key
KB_AGENT_GITHUB_TOKEN=ghp_your-github-token

# Supabase (kbagent's dedicated project)
SUPABASE_URL=https://bfukukrjapjimxnadwuv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
