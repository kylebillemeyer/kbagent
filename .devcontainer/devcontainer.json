{
  "name": "kbagent-agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && mkdir -p ~/.claude && echo '{ \"enableAllProjectMcpServers\": true }' > ~/.claude/settings.json",
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:KB_AGENT_CLAUDE_CODE_OAUTH_TOKEN}",
    "GITHUB_TOKEN": "${localEnv:KB_AGENT_GITHUB_TOKEN}",
    "NOTION_TOKEN": "${localEnv:KB_AGENT_NOTION_API_KEY}"
  }
}
