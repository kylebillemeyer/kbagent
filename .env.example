# Global credentials for kbagent.
# Copy to ~/.kbagent/.env and fill in values.
# Run `kbagent -f /path/to/file daemon` to override the default location.
#
# Project-specific config (repo path, worktrees dir, Plane project/states, etc.)
# belongs in kbagent.toml at the root of each target project repo.

KB_AGENT_PLANE_API_KEY=your-plane-api-key
KB_AGENT_GITHUB_TOKEN=ghp_your-github-token
KB_AGENT_CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token

# Supabase (kbsupa project)
SUPABASE_URL=https://yhjohodtdasgkdtjlfzt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MCP servers inside DevPod workspaces.
# These must also be exported in your shell environment (e.g. ~/.zshrc or ~/.bashrc)
# so that DevPod can inject them into agent containers via remoteEnv in devcontainer.json.
NOTION_API_KEY=your-notion-api-key
PLANE_API_KEY=your-plane-api-key
PLANE_WORKSPACE_SLUG=your-plane-workspace-slug
