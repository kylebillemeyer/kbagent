# Global credentials for kbagent.
# Copy to ~/.kbagent/.env and fill in values.
# Run `kbagent -f /path/to/file daemon` to override the default location.
#
# Project-specific config (repo path, worktrees dir, Plane project/states, etc.)
# belongs in kbagent.toml at the root of each target project repo.

KB_AGENT_PLANE_API_KEY=your-plane-api-key
KB_AGENT_GITHUB_TOKEN=ghp_your-github-token
KB_AGENT_CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token

# Supabase (kbsupa project)
SUPABASE_URL=https://yhjohodtdasgkdtjlfzt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MCP server credentials for agent containers.
# Define these with the KB_AGENT_ prefix on the host. remoteEnv in
# .devcontainer/devcontainer.json maps each one to the unprefixed name the MCP server
# natively expects inside the container (e.g. KB_AGENT_NOTION_API_KEY -> NOTION_TOKEN),
# so project .mcp.json files need no env mapping. Plane MCP reuses KB_AGENT_PLANE_API_KEY
# above.
KB_AGENT_NOTION_API_KEY=your-notion-api-key
KB_AGENT_PLANE_WORKSPACE_SLUG=your-plane-workspace-slug
